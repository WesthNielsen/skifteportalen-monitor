{
  "name": "skifteportalen-spec-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Daily Skifteportalen API documentation change monitor for GitHub Actions.",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build": "bun --bun tsc",
    "start": "bun dist/index.js",
    "check": "bun --bun tsc --noEmit && bun --bun tsc -p tsconfig.test.json",
    "test": "bun test",
    "check:live": "bun src/live-check.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "diff": "^9.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
